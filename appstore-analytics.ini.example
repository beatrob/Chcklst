[appstore]
# From App Store Connect → Users and Access → Integrations → App Store Connect API.
key_id = YOUR_KEY_ID
issuer_id = YOUR_ISSUER_UUID

# Keep the .p8 file outside this repository. ~ is supported.
private_key_path = ~/Secrets/AuthKey_YOUR_KEY_ID.p8

# Find this using: python3 tools/appstore_analytics.py apps
app_id = YOUR_APP_STORE_CONNECT_APP_ID

# Local directory for downloaded reports and the Markdown summary.
output_dir = appstore-analytics
